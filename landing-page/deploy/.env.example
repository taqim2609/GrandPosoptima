# Template environment untuk deploy/docker-compose-p1a.yml (POS Node/Express).
# Pakai:  cp deploy/.env.example deploy/.env   lalu isi nilai sebenarnya.
# chmod 600 deploy/.env  — berkas .env tidak pernah di-commit.

# WAJIB (compose menolak start bila kosong)
JWT_SECRET=ganti-dengan-acak-panjang
DATABASE_URL=postgresql://grandpos:ganti-password@db:5432/grandpos
NODE_SYNC_KEY=ganti-dengan-acak-panjang

# Opsional (ada default di compose)
ANALYTICS_URL=http://172.20.0.1:8000
HERMES_WA_WEBHOOK_URL=http://127.0.0.1:8644/webhooks/grandpos-outbox

# WAJIB: path absolut folder kode POS di host (bind-mount /app).
# Contoh di host gudang-644: /root/grandpos-project/pos-engine
POS_ENGINE_DIR=/path/absolut/ke/pos-engine
