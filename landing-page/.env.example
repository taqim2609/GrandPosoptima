# GrandPOS — template environment untuk docker compose.
#
# Pakai:  cp .env.example .env   lalu ganti setiap CHANGE_ME dengan nilai kuat.
# Berkas `.env` tidak pernah di-commit (lihat .gitignore).
# Compose menolak start bila variabel bertanda WAJIB masih kosong.
#
# Ganti CHANGE_ME dengan acak panjang, misalnya: openssl rand -hex 32

# --- Database (WAJIB) ---
POSTGRES_USER=grandpos
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=grandpos
POSTGRES_PORT=5432
DATABASE_URL=postgresql://grandpos:CHANGE_ME_POSTGRES_PASSWORD@db:5432/grandpos

# --- API (WAJIB) ---
# Kunci untuk sinkronisasi POS -> gudang. Endpoint terproteksi fail-closed.
POS_API_KEY=CHANGE_ME_POS_API_KEY

# --- Opsional ---
TZ=Asia/Jakarta
API_PORT=8000
# Token khusus kiosk Pi -> gudang. Kosong = endpoint /sync/* menolak semua kiriman.
NODE_SYNC_KEY=
# Role read-only untuk analis/AI. Kosong = fitur analitik nonaktif.
AI_DATABASE_URL=

# --- Bootstrap manual & worker (tidak dibaca compose) ---
# Password akun superadmin untuk db/bootstrap_superadmin.sql.
GRANDPOS_SUPERADMIN_PASSWORD=CHANGE_ME_SUPERADMIN_PASSWORD
# Kunci HMAC untuk request outbox WhatsApp.
GRANDPOS_OUTBOX_SECRET=CHANGE_ME_OUTBOX_SECRET

# --- Gateway WhatsApp / Hermes (dipakai deploy/ dan gateway/) ---
WA_OWNER_NUMBER=
WA_ALLOWED_NUMBERS=
JWT_SECRET=CHANGE_ME_JWT_SECRET
HERMES_WA_WEBHOOK_URL=
ANALYTICS_URL=
