{
  "appId": "host.emergent.hybridposaceh",
  "appName": "Grand Aceh Kuliner POS",
  "webDir": "dist",
  "server": {
    "cleartext": true,
    "androidScheme": "http",
    "allowNavigation": [
      "pos.local",
      "*.local",
      "192.168.*.*",
      "10.*.*.*",
      "100.*.*.*",
      "127.0.0.1",
      "localhost",
      "*.ts.net",
      "*.run.app",
      "*.ai.studio"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "androidScheme": "http"
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": false,
      "resetWhenUpdate": true,
      "statsUrl": false
    }
  }
}
