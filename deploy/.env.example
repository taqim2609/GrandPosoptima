# Salin menjadi .env lalu isi nilainya. Jangan commit .env.
# Nilai JWT_SECRET / NODE_SYNC_KEY harus sama dengan yang dipakai container
# yang sedang berjalan; jangan membuat nilai baru saat adopsi Compose.

JWT_SECRET=
NODE_SYNC_KEY=

CORS_ORIGINS=http://localhost,http://127.0.0.1:3000
ANALYTICS_URL=http://172.20.0.1:8000
HERMES_WA_WEBHOOK_URL=http://127.0.0.1:8644/webhooks/grandpos-outbox

POS_ENGINE_DIR=/root/grandpos-project/pos-engine
GRANDPOS_DATA_DIR_HOST=/root/grandpos-project/pos-engine/data
NODE_ID=gudang7783
