# Salin ke .env lalu isi. Jangan commit .env -- hanya berkas contoh ini yang masuk git.
# `docker compose` menolak start bila salah satu wajib kosong.

# Tanda tangan JWT untuk sesi kasir dan admin. Buat baru:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# PostgreSQL analytics (FastAPI). Untuk host gudang: db:5432/grandpos
DATABASE_URL=

# Kunci sinkronisasi POS <-> analytics.
NODE_SYNC_KEY=

# Opsional. Default di docker-compose.host.yml sudah benar untuk host gudang.
# ANALYTICS_URL=http://172.20.0.1:8000
# CORS_ORIGINS=http://localhost,http://127.0.0.1:3000
# POS_ENGINE_DIR=/root/grandpos/pos-engine
