rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Test connectivity document
    match /test/{testId} {
      allow read, write: if isValidId(testId);
    }

    // Products collection (POS catalog sync)
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isValidId(categoryId);
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if true;
      allow write: if isValidId(orderId);
    }

    // Error logs collection for client diagnostics
    match /error_logs/{logId} {
      allow read: if true;
      allow write: if isValidId(logId);
    }
  }
}
