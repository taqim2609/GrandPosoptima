# ====================================================================
# GRAND ACEH KULINER POS — DOCKER ENVIRONMENT CONFIGURATION (.env.docker)
# ====================================================================

# Port FastAPI Server Internal (Default: 8001)
PORT=8001

# MongoDB Connection
MONGO_URL=mongodb://mongo:27017/grand_pos
DB_NAME=grand_pos

# Keamanan JWT (Ganti dengan string acak panjang unik minimal 32 karakter)
JWT_SECRET=grandpos_change_me_to_a_secure_random_string_32_chars!

# Akun Super Admin / Owner Pertama
ADMIN_EMAIL=owner@grandacehkuliner.com
ADMIN_PASSWORD=admin123

# CORS Origins (Gunakan * untuk LAN offline lokal)
CORS_ORIGINS=*

# Jumlah Worker Uvicorn FastAPI (Rekomendasi: 2 untuk Raspberry Pi, 4 untuk PC/VPS)
UVICORN_WORKERS=2

# ------------------------------------------------------------------
# WhatsApp / identitas node — TIDAK di sini
# ------------------------------------------------------------------
# Variabel NODE_ID, NODE_ROLE, HERMES_BRIDGE_*, WA_WEBHOOK_SECRET, dan
# HERMES_CMD_ALLOWLIST dibaca Docker Compose dari berkas project/.env
# (bukan dari .env.docker ini), karena nilai pada blok `environment:` di
# docker-compose.yml selalu menang atas `env_file:`.
#
#   project/.env.gudang.example  -> contoh untuk server gudang-644 (primary)
#   project/.env                 -> salinan nyata per node (jangan di-commit)
#
# Di Pi (backup) berkas itu cukup berisi NODE_ROLE=backup tanpa URL/secret:
# fitur WA mati-lunak, pesan yang gagal tersimpan di outbox, lalu dikirim
# SEKALI oleh server gudang setelah sinkron.
