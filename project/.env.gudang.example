# ====================================================================
# GRAND ACEH KULINER POS — KONFIGURASI NODE (dibaca Docker Compose)
# ====================================================================
# Salin berkas ini menjadi `project/.env` di masing-masing node.
#
#   Server gudang-644 (primary): isi lengkap seperti di bawah, lalu jalankan
#     docker compose -f docker-compose.yml -f docker-compose.gudang.yml up -d --build
#
#   Raspberry Pi (backup): cukup berisi
#     NODE_ID=pi
#     NODE_ROLE=backup
#   tanpa HERMES_WA_* . Dengan begitu Pi tidak pernah mengirim WhatsApp; pesan
#   yang gagal tersimpan di koleksi wa_outbox (idempoten) dan dikirim SEKALI
#   oleh server gudang setelah sinkron.
#
# JANGAN commit berkas .env yang sudah berisi nilai nyata.

# Identitas node: primary = pengirim WhatsApp, backup = Pi.
# Bawaan bila kosong adalah "backup", jadi node baru tidak mengirim WA
# sebelum dinyatakan primary secara eksplisit.
NODE_ID=644
NODE_ROLE=primary

# Port backend di host, dibuka HANYA di loopback (lihat docker-compose.gudang.yml).
# Dipakai plugin Hermes (proses di host yang sama) untuk mengirim pesan WA masuk.
BACKEND_PORT=8001

# --- WhatsApp: Hermes gateway (HANYA server gudang-644) ---
# POS tidak menjalankan bridge WhatsApp sendiri. Sesi WhatsApp (Baileys) dipegang
# gateway Hermes di host ini:
#   * arah keluar (POS -> pelanggan) lewat webhook adapter Hermes dengan
#     deliver_only: true dan deliver: whatsapp;
#   * arah masuk (pelanggan -> POS) lewat plugin `pre_gateway_dispatch`
#     (project/hermes-integration/grandpos-wa-inbound).
#
# URL route adapter. WAJIB loopback; jangan pernah diisi alamat publik/Tailnet.
HERMES_WA_WEBHOOK_URL=http://127.0.0.1:8644/webhooks/grandpos-outbox

# Secret HMAC route (juga dipakai plugin untuk header X-Hermes-Secret ke POS).
# Bangkitkan dengan: openssl rand -hex 32
HERMES_WA_WEBHOOK_SECRET=ganti_dengan_secret_acak_panjang
HERMES_WA_ENABLED=1

# Secret webhook pesan masuk. Isi nilai yang SAMA dengan HERMES_WA_WEBHOOK_SECRET.
WA_WEBHOOK_SECRET=ganti_dengan_secret_acak_panjang

# Allowlist perintah WhatsApp per-role.
# Format: /perintah:role1,role2;/perintah2:role
# Kosongkan untuk memakai bawaan:
#   /stok            -> kasir, admin, superadmin
#   /laporan-shift   -> admin, superadmin
#   /dashboard       -> admin, superadmin
HERMES_CMD_ALLOWLIST=
