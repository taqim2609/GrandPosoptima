        "jsCode": "const items = $input.first().json || [];\nconst lowStock = items.filter(item => item.current_stock <= (item.min_stock || 5));\nreturn [{ json: { count: lowStock.length, lowStockItems: lowStock } }];"
      },
      "name": "Filter Stok < Min Stock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    }
