# ====================================================================
# GRAND ACEH KULINER POS — VPS PRODUCTION ENVIRONMENT CONFIG (.env.vps)
# PERINGATAN: WAJIB GANTI SEMUA KUNCI RAHASIA DI BAWAH INI SEBELUM GO-LIVE!
# ====================================================================

# 1. Domain & SSL Let's Encrypt Email (Arahkan DNS domain VPS Anda)
DOMAIN_POS=pos.yourdomain.com
DOMAIN_N8N=n8n.yourdomain.com
DOMAIN_WA=wa.yourdomain.com
SSL_EMAIL=admin@yourdomain.com

# 2. Key Keamanan Backend POS (Gunakan openssl rand -hex 32)
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG_MINIMAL_32_KARAKTER
ADMIN_EMAIL=owner@grandacehkuliner.com
ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_ANDA

# 3. Kunci AI (Opsional — Bisa diisi atau dikosongkan)
GEMINI_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=

# 4. Evolution API (WhatsApp Gateway)
EVOLUTION_API_KEY=GANTI_DENGAN_API_KEY_ACAK_EVOLUTION_2026

# 5. Database PostgreSQL n8n
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=GANTI_DENGAN_PASSWORD_DB_POSTGRES_YANG_KUAT
N8N_DB_NAME=n8n_vps_db

# 6. Kunci Enkripsi Master n8n (Min 16 karakter acak)
N8N_ENCRYPTION_KEY=GANTI_DENGAN_KUNCI_ENKRIPSI_ACAK_MIN_16_KARAKTER

# 7. Worker Uvicorn FastAPI
UVICORN_WORKERS=4
